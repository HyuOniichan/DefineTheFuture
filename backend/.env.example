# Server running port
PORT=

# Postgres database URL
DATABASE_URL=

# Frontend's url (from which call backend API)
FRONTEND_URL=

# Bcrypt config for hashing password
BCRYPT_SALT_ROUNDS=

# JsonWebToken (JWT) config
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=
JWT_REFRESH_TOKEN_EXPIRES_IN=

# Cookies options
COOKIE_SECURE=
COOKIE_SAMESITE=
